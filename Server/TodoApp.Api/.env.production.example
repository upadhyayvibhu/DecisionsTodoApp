# Set these values in your production host's secret manager or environment settings.
# Do not deploy a real .env file with your application.

ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Server=YOUR_PRODUCTION_SERVER;Database=TodoAppDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False
Jwt__Key=replace-with-a-long-random-production-secret
Jwt__Issuer=TodoApp.Api
Jwt__Audience=TodoApp.Client
Jwt__ExpiryMinutes=60
Cors__AllowedOrigins__0=https://your-client-domain.example
