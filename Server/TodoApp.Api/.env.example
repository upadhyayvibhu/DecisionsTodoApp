# Copy this file to .env for local development. Do not commit the copied file.
# Environment variable names use __ to represent nested configuration sections.

ConnectionStrings__DefaultConnection=Server=YOUR_SERVER;Database=TodoAppDb;Trusted_Connection=True;TrustServerCertificate=True
Jwt__Key=replace-with-a-random-secret-at-least-32-characters-long
Jwt__Issuer=TodoApp.Api
Jwt__Audience=TodoApp.Client
Jwt__ExpiryMinutes=60
Cors__AllowedOrigins__0=http://localhost:5173
